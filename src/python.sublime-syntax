%YAML 1.2
---
name: Python
file_extensions:
  - py
  - py3
  - pyw
  - pyi
  - pyx
scope: source.python

contexts:
  main:
    - include: comments
    - include: triple-double-strings
    - include: triple-single-strings
    - include: double-strings
    - include: single-strings
    - include: keywords
    - include: builtins
    - include: constants
    - include: decorators
    - include: numbers
    - include: operators
    - include: punctuation

  comments:
    - match: '#[^\n]*'
      scope: comment.line.python

  triple-double-strings:
    - match: '"""'
      push: triple-double-string-body

  triple-double-string-body:
    - meta_scope: string.quoted.triple.double.python
    - match: '"""'
      pop: true
    - match: '\\.'
      scope: constant.character.escape.python

  triple-single-strings:
    - match: "'''"
      push: triple-single-string-body

  triple-single-string-body:
    - meta_scope: string.quoted.triple.single.python
    - match: "'''"
      pop: true
    - match: '\\.'
      scope: constant.character.escape.python

  double-strings:
    - match: 'f?"'
      push: double-string-body

  double-string-body:
    - meta_scope: string.quoted.double.python
    - match: '"'
      pop: true
    - match: '\\.'
      scope: constant.character.escape.python

  single-strings:
    - match: "f?'"
      push: single-string-body

  single-string-body:
    - meta_scope: string.quoted.single.python
    - match: "'"
      pop: true
    - match: '\\.'
      scope: constant.character.escape.python

  keywords:
    - match: '\b(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\b'
      scope: keyword.control.python

  builtins:
    - match: '\b(abs|all|any|ascii|bin|bool|breakpoint|bytearray|bytes|callable|chr|classmethod|compile|complex|copyright|credits|delattr|dict|dir|divmod|enumerate|eval|exec|exit|filter|float|format|frozenset|getattr|globals|hasattr|hash|help|hex|id|input|int|isinstance|issubclass|iter|len|license|list|locals|map|max|memoryview|min|next|object|oct|open|ord|pow|print|property|quit|range|repr|reversed|round|set|setattr|slice|sorted|staticmethod|str|sum|super|tuple|type|vars|zip|__import__)\b'
      scope: support.function.builtin.python
    - match: '\b(self|cls)\b'
      scope: variable.language.python

  constants:
    - match: '\b(True|False|None|Ellipsis|NotImplemented)\b'
      scope: constant.language.python
    - match: '\b(__name__|__file__|__doc__|__package__|__spec__|__loader__|__builtins__|__all__|__version__|__author__)\b'
      scope: support.variable.python

  decorators:
    - match: '@[a-zA-Z_][a-zA-Z0-9_.]*'
      scope: entity.name.function.decorator.python

  numbers:
    - match: '\b0[xX][0-9a-fA-F]+\b'
      scope: constant.numeric.hex.python
    - match: '\b0[bB][01]+\b'
      scope: constant.numeric.binary.python
    - match: '\b0[oO][0-7]+\b'
      scope: constant.numeric.octal.python
    - match: '\b[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.python

  operators:
    - match: '(==|!=|<=|>=|<<?|>>?|\*\*?|//|[+\-*/%@&|^~]|->)'
      scope: keyword.operator.python
    - match: '='
      scope: keyword.operator.assignment.python

  punctuation:
    - match: '[{}()\[\]]'
      scope: punctuation.section.python
    - match: '[,;:.]'
      scope: punctuation.separator.python
